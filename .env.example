# Supabase (Project Settings -> API in your Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Server-only: service role key for admin operations (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Client-side copies (Vite exposes only VITE_* vars to the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# AI OCR / analysis — free key from https://openrouter.ai/keys
# Default model is google/gemini-2.5-flash (free tier); override with any vision model.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# OPENROUTER_MODEL=google/gemini-2.5-flash
